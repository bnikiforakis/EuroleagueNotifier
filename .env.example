# Copy to .env and fill in. Never commit .env.

# PiButler gateway (reachable on the shared docker network)
PIBUTLER_URL=http://pibutler:8080
PIBUTLER_API_KEY=change-me
# Key of the separate "eurocup" project in PiButler (the eurocup-notifier service uses it)
EUROCUP_PIBUTLER_API_KEY=change-me-too
# EuroCup's schedule / results times; keep them apart from DIGEST_TIME / RESULTS_TIME
EUROCUP_DIGEST_TIME=12:30
EUROCUP_RESULTS_TIME=01:30
# Key of the separate "gbl" project in PiButler (the gbl-notifier service: Greek Basket League)
GBL_PIBUTLER_API_KEY=change-me-three
# GBL's schedule / results times (weekend games can tip off at 13:00)
GBL_DIGEST_TIME=11:30
GBL_RESULTS_TIME=00:30

# Competitions this service follows: E = EuroLeague. EuroCup runs as its own service
# (eurocup-notifier in docker-compose.yml), so don't add U here or its games are announced twice.
# G = Greek Basket League, also its own service (gbl-notifier); it can't be combined with E/U.
COMPETITIONS=E
# Name shown in /settings and messages, and the live-scores command (lowercase, no slash)
PROJECT_NAME=EuroLeague
SCORE_COMMAND=score
# Season start year (2026 = the 2026-27 season)
SEASON_YEAR=2026

# Minutes before tip-off to send the reminder
REMINDER_MINUTES=30

# Daily schedule of today's games (with Follow buttons), sent at this local time
DIGEST_TIME=12:00
DIGEST_TIMEZONE=Europe/Athens
# Nightly results of the day's games (one message, silent), at this local time
RESULTS_TIME=01:00
# Mondays: each followed team's games of the week (one silent message per team), at this local time
WEEKLY_TIME=10:00

# /score command: PiButler calls this URL (internal docker network only; the port isn't published)
CALLBACK_URL=http://euroleague-notifier:8081/pibutler

DB_PATH=/data/euroleague_notifier.db
LOG_LEVEL=INFO
